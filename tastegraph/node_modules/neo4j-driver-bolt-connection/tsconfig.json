{
  "compilerOptions": {
    "target": "ES2015",
    "lib": ["ES2015"],
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "module": "Node16",
    "moduleResolution": "node16",
    "outDir": "lib",
    "allowJs": true,
    "isolatedModules": true
  },
  "include": ["src/**/*.js", "types/**/*.ts"]
}
