{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "TasteGraph Streamlit",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "module": "streamlit",
      "cwd": "${workspaceFolder}",
      "args": [
        "run",
        "app.py",
        "--server.headless",
        "true",
        "--browser.gatherUsageStats",
        "false"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}